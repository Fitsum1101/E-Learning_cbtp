
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



model User {
  id            String        @id @default(uuid())
  firstName     String
  lastName      String
  userName      String        @unique
  email         String        @unique
  profilePicture String?
  password      String
  role          Role          @default(STUDENT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  creator       User?         @relation("UserCreator", fields: [createdBy], references: [id])
  createdUsers  User[]        @relation("UserCreator")

 
  enrollments   Enrollment[]
  ratings       Rating[]
  testimonials  Testimonial[]
  examSession   ExamSession[]


}

model CourseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  creaedAt DateTime @default(now())

  courses   Course[]
}

model Course {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  description   String
  level         String         @default("Beginner")
  thumbnail     String
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categoryId    String
  adminId       String

  category      CourseCategory @relation(fields: [categoryId], references: [id])
  enrollments   Enrollment[]
 

  chapters      Chapter[]
  ratings       Rating[]
  testimonials  Testimonial[]
  questions     Question[]
  exams         Exam[]
}

model Chapter {
  id          String      @id @default(uuid())
  title       String
  order       Int
  courseId    String
  createdAt   DateTime    @default(now())
  course      Course      @relation(fields: [courseId], references: [id])
  subChapters SubChapter[]
}

model SubChapter {
  id          String      @id @default(uuid())
  title       String
  fileUrl     String
  minute      Int
  order       Int
  chapterId   String
  createdAt   DateTime    @default(now())

  chapter     Chapter     @relation(fields: [chapterId], references: [id])
  progress    Progress[]
  resources   Resource[]
  bookmarks   Bookmark []
}

model Resource {
  id            String      @id @default(uuid())
  fileUrl       String
  fileType      String
  subChapterId  String
  createdAt     DateTime    @default(now())

  subChapter    SubChapter  @relation(fields: [subChapterId], references: [id])
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  completed  Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])
  progress   Progress[]
  bookmarks  Bookmark[]
}

model Exam {
  id             String   @id @default(uuid())
  courseId       String    @default("7160c64f-5a46-494d-9aca-131ce2e5f81a")
 
  createdAt      DateTime @default(now())


  course      Course     @relation(fields: [courseId], references: [id])
  
  ExamAttempts    ExamAttempts[]
}

model ExamAttempts{
  id             String   @unique  @default(uuid())
  examId         String    
  attempt        Int      @default(1)
  duration       Int      @default(20)
  passingScore   Int      @default(20)


  createdAt DateTime @default(now())


  @@id([examId, attempt])

  exam            Exam     @relation(fields: [examId], references: [id])
  examQuestions   ExamQuestions[]
  examSession     ExamSession[]
}


model ExamSession {
  id            String        @id @default(uuid())
  attemptId     String
  userId        String        @unique   
  startedAt     DateTime      @default(now())
  endsAt        DateTime?     
  submittedAt   DateTime?    
  over          Boolean            @default(false) 
  status        ExamSessionStatus   @default(IN_PROGRESS)
  score         Int?          
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  examAnswer    ExamAnswer[]
  user          User          @relation(fields: [userId], references: [id])
  examAttempts  ExamAttempts  @relation(fields: [attemptId], references: [id])
}


model ExamAnswer {
  id               String    @default(uuid())
  examSessionId     String
  questionId        String
  answerId           String 
  
   @@id([examSessionId,questionId])
  ExamSession   ExamSession  @relation(fields: [examSessionId],  references: [id])
}

model Bookmark {
  id           String      @id @default(uuid())
  enrollmentId String
  subChapterId String      
  createdAt    DateTime    @default(now())
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id])

  subChapter   SubChapter?  @relation(fields: [subChapterId],  references: [id])
  @@unique([enrollmentId, subChapterId])
}


model Progress {
  id           String      @id @default(uuid())
  enrollmentId String
  subChapterId String
  watchedAt    DateTime    @default(now())
  completed    CourseProgressStatus @default(IN_PROGRESS)
  watchedAgain   DateTime  @default(now()) @updatedAt()

  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id])
  subChapter   SubChapter  @relation(fields: [subChapterId], references: [id])
}

model AvatarCategory {
  id        String   @id @default(uuid())
  style      String   
  createdAt DateTime @default(now())
  Avatar    Avatar[]
}

model Avatar {
   id        String   @id @default(uuid())
   seed      String
   styleId   String
   courseComplete Int @default(0)
   courseEnrolled Int @default(0)
   courseCertificates Int @default(0)
   createdAt DateTime @default(now())
   AvatarCategory    AvatarCategory @relation(fields: [styleId], references: [id])
}


model Question {
  id        String     @id @default(uuid())
  question  String
  courseId    String

 

  course         Course       @relation(fields: [courseId], references: [id])
  examQuestions  ExamQuestions[]
  options        Option[]
}


model ExamQuestions{
  id           String   @id @default(uuid())
  attemptId    String   
  questionId   String
  attempt      Int        @default(1)

  ExamAttempts        ExamAttempts     @relation(fields: [attemptId], references: [id])
  question             Question        @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}


model Option {
  id         String    @id @default(uuid())
  text       String
  isCorrect  Boolean   @default(false)
  questionId String

  question   Question  @relation(fields: [questionId], references: [id])
}


model Rating {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  userId     String
  courseId   String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Testimonial {
  id         String   @id @default(uuid())
  message    String
  approved   Boolean  @default(false)
  userId     String
  courseId   String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  course     Course?  @relation(fields: [courseId], references: [id])
}

enum Role{
       STUDENT
       ADMIN
       SUPER_ADMIN
}

enum ExamStatus{
  NOT_TAKEN
  FAILED
  PASS
}

enum CourseProgressStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
}

enum ExamSessionStatus {
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}
